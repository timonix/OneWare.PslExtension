 #include "ghdl/synth.h"
 
+#ifdef _WIN32
+#include <windows.h>
+
+//  GHDL looks for its std and ieee libraries in a prefix compiled into libghdl. When the plugin
+//  is shipped on its own, the libraries are next to it: <plugin dir>/lib.
+static std::string ghdl_default_prefix()
+{
+	HMODULE module = nullptr;
+	char path[MAX_PATH];
+	if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+				reinterpret_cast<LPCSTR>(&ghdl_default_prefix), &module))
+		return "";
+	DWORD len = GetModuleFileNameA(module, path, MAX_PATH);
+	if (len == 0 || len == MAX_PATH)
+		return "";
+	std::string dir(path, len);
+	size_t sep = dir.find_last_of("\\/");
+	if (sep == std::string::npos)
+		return "";
+	return "--PREFIX=" + dir.substr(0, sep) + "/lib";
+}
+#endif
+
 using namespace GhdlSynth;
 
